{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "html-host",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // 画面（静的アセット）+ API（Worker）。/api/* だけ Worker のコードで処理し、それ以外は静的アセットを返す
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // アプリの DB。接続キーは存在せず、Worker から binding 経由でのみ操作できる
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "html-host",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID", // wrangler d1 create の出力で置き換える
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "html-host-contents" }
  ],
  "vars": {
    // Cloudflare Access の検証用（README「DB版のセットアップ」参照）
    "TEAM_DOMAIN": "https://orange-queen-a550.cloudflareaccess.com",
    "POLICY_AUD": "REPLACE_WITH_ACCESS_AUD" // infra/access の terraform output access_aud
  },
  "observability": { "enabled": true }
}
